<?xml version="1.0" encoding="utf-8"?>
<UANodeSet xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:uax="http://opcfoundation.org/UA/2008/02/Types.xsd">

    <!-- 命名空间声明 -->
    <NamespaceUris>
        <Uri>http://yourcompany.com/opcua/racksignals/</Uri>
    </NamespaceUris>

    <Models>
        <Model ModelUri="http://yourcompany.com/opcua/racksignals/"
               Version="1.0.0"
               PublicationDate="2025-11-06T00:00:00Z">
            <RequiredModel ModelUri="http://opcfoundation.org/UA/"/>
        </Model>
    </Models>

    <!-- 定义 RackSignalsType 对象类型 -->
    <UAObjectType NodeId="ns=1;i=1001" BrowseName="1:RackSignalsType">
        <DisplayName>RackSignalsType</DisplayName>
        <Description>机架系统信号接口，描述扫描机架的运动和传感器状态</Description>
        <References>
            <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference> <!-- BaseObjectType -->
        </References>
    </UAObjectType>

    <!-- 以下为 RackSignalsType 下的各个 Variable 成员定义 -->

    <UAVariable NodeId="ns=1;i=2001" BrowseName="1:horizontalPulse"
                ParentNodeId="ns=1;i=1001"
                DataType="Double" ValueRank="-1">
        <DisplayName>horizontalPulse</DisplayName>
        <Description>横向脉冲计数，数值增加=前进，减少=后退</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <UAVariable NodeId="ns=1;i=2002" BrowseName="1:leftLimit"
                ParentNodeId="ns=1;i=1001"
                DataType="Boolean" ValueRank="-1">
        <DisplayName>leftLimit</DisplayName>
        <Description>左限位信号（true 表示已触发）</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <UAVariable NodeId="ns=1;i=2003" BrowseName="1:rightLimit"
                ParentNodeId="ns=1;i=1001"
                DataType="Boolean" ValueRank="-1">
        <DisplayName>rightLimit</DisplayName>
        <Description>右限位信号（true 表示已触发）</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <UAVariable NodeId="ns=1;i=2004" BrowseName="1:resetSignal"
                ParentNodeId="ns=1;i=1001"
                DataType="Boolean" ValueRank="-1">
        <DisplayName>resetSignal</DisplayName>
        <Description>归零信号（true 表示触发）</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <UAVariable NodeId="ns=1;i=2005" BrowseName="1:swapDirection"
                ParentNodeId="ns=1;i=1001"
                DataType="Boolean" ValueRank="-1">
        <DisplayName>swapDirection</DisplayName>
        <Description>换向信号（true 表示发生换向）</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <UAVariable NodeId="ns=1;i=2006" BrowseName="1:motionDirection"
                ParentNodeId="ns=1;i=1001"
                DataType="Boolean" ValueRank="-1">
        <DisplayName>motionDirection</DisplayName>
        <Description>运动方向（true=正向/右，false=反向/左）</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <UAVariable NodeId="ns=1;i=2007" BrowseName="1:probeValue"
                ParentNodeId="ns=1;i=1001"
                DataType="Double" ValueRank="-1">
        <DisplayName>probeValue</DisplayName>
        <Description>探头测量值（单位 μm）</Description>
        <References>
            <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=1001</Reference>
        </References>
    </UAVariable>

    <!-- 定义实例对象 RackSignals1 -->
    <UAObject NodeId="ns=1;i=3001" BrowseName="1:RackSignals1" TypeDefinition="ns=1;i=1001">
        <DisplayName>RackSignals1</DisplayName>
        <Description>机架测厚仪信号实例</Description>
    </UAObject>

</UANodeSet>
