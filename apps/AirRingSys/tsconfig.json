{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@jjsk/air-ring-server": ["../../packages/AirRingServer/index.ts"],
      "@jjsk/air-ring-server/*": ["../../packages/AirRingServer/*"],
      "@jjsk/core": ["../../packages/core/index.ts"],
      "@jjsk/core/*": ["../../packages/core/*"],
      "@jjsk/ad-box": ["../../packages/Adbox-sdk/index"],
      "@jjsk/ad-box/*": ["../../packages/Adbox-sdk/*"]
    },
    "types": ["element-plus/global"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src",
    "electron",
    "auto-imports.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json"}]
}
